# syntax=docker/dockerfile:1.7

# Builders are digest-pinned. npm and pip exist only in these stages and are
# deliberately absent from the final worker.
FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS node-deps
WORKDIR /build
COPY browser_runtime/node/package.json browser_runtime/node/package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --ignore-scripts --omit=dev \
    && npm cache clean --force

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS python-deps
COPY browser_runtime/python/requirements.lock /tmp/requirements.lock
RUN python -m pip install \
      --prefix=/install \
      --only-binary=:all: \
      --require-hashes \
      --no-cache-dir \
      -r /tmp/requirements.lock

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS browser-runtime

ARG DEBIAN_SNAPSHOT=20260720T000000Z
ARG DAEMON_UID=65531
ARG DAEMON_GID=65531
ARG WORKER_UID=65529
ARG WORKER_GID=65529

LABEL org.opencontainers.image.title="ChatDS session sandbox dependency profile" \
      org.opencontainers.image.description="Prebuilt Python, Node, Bash, Playwright and Selenium worker dependencies; no runtime package installation" \
      org.opencontainers.image.chatds.profile="browser-automation-v1" \
      org.opencontainers.image.chatds.egress-policy="signed-exact-query-v1" \
      org.opencontainers.image.chatds.debian-snapshot="${DEBIAN_SNAPSHOT}"

# The timestamped Debian archives are immutable. Chromium and chromium-driver
# are installed from the same snapshot and their exact resolved versions are
# captured in installed-manifest.json below.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ bookworm-security main" \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      bash \
      chromium \
      chromium-driver \
      curl \
      dumb-init \
      fonts-noto-cjk \
      libstdc++6 \
      passwd \
      util-linux \
      weston \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node
COPY --from=node-deps /build/node_modules /opt/chatds-browser-runtime/node_modules
COPY --from=python-deps /install/ /usr/local/

COPY browser_runtime/profile.json /opt/chatds-browser-runtime/profile.json
COPY runtime/common-python-requirements.in /opt/chatds-browser-runtime/common-python-requirements.in
COPY browser_runtime/chatds_browser_runtime /usr/local/lib/python3.12/site-packages/chatds_browser_runtime
COPY browser_runtime/bin/ /usr/local/bin/
COPY browser_runtime/smoke/ /opt/chatds-browser-runtime/smoke/

ENV NODE_PATH=/opt/chatds-browser-runtime/node_modules \
    PLAYWRIGHT_BROWSERS_PATH=/opt/chatds-browser-runtime/ms-playwright \
    BROWSER_EXECUTABLE=/usr/local/bin/chatds-chromium-proxy \
    CHROME_BIN=/usr/local/bin/chatds-chromium-proxy \
    PYTHONUNBUFFERED=1

RUN groupadd --gid "${DAEMON_GID}" chatds-browser-daemon \
    && useradd --uid "${DAEMON_UID}" --gid "${DAEMON_GID}" \
      --no-create-home --shell /usr/sbin/nologin chatds-browser-daemon \
    && groupadd --gid "${WORKER_GID}" chatds-browser-worker \
    && useradd --uid "${WORKER_UID}" --gid "${WORKER_GID}" \
      --no-create-home --shell /usr/sbin/nologin chatds-browser-worker \
    && install -d -o "${DAEMON_UID}" -g "${DAEMON_GID}" -m 0700 /run/chatds-browser-daemon \
    && install -d -o "${WORKER_UID}" -g "${WORKER_GID}" -m 0700 /workspace \
    && install -d -o root -g root -m 0755 /usr/lib/chatds-browser-runtime \
    && mv /usr/bin/chromium /usr/lib/chatds-browser-runtime/chromium.debian \
    && chmod 0755 /usr/local/bin/chatds-browser-runtime-exec \
      /usr/local/bin/chatds-chromium-proxy \
      /usr/local/bin/chatds-browser-runtime-health \
      /usr/local/bin/chatds-skill-egress-bridge \
      /usr/lib/chatds-browser-runtime/chromium.debian \
    && ln -s /usr/local/bin/chatds-chromium-proxy /usr/bin/chromium \
    && ln -s /opt/chatds-browser-runtime/node_modules /node_modules \
    && expected_browser="$(node -e "process.stdout.write(require('playwright').chromium.executablePath())")" \
    && mkdir -p "$(dirname "${expected_browser}")" \
    && ln -s /usr/local/bin/chatds-chromium-proxy "${expected_browser}" \
    && expected_headless="$(node -e "const core=require('/opt/chatds-browser-runtime/node_modules/playwright-core/lib/coreBundle.js'); process.stdout.write(core.registry.registry.findExecutable('chromium-headless-shell').executablePath())")" \
    && mkdir -p "$(dirname "${expected_headless}")" \
    && ln -s /usr/local/bin/chatds-chromium-proxy "${expected_headless}" \
    && /usr/local/bin/python -I -m chatds_browser_runtime.healthcheck \
      --write-installed-manifest /opt/chatds-browser-runtime/installed-manifest.json \
    && test "$(/usr/local/bin/python -I -c 'from chatds_browser_runtime.proxy_bridge import EGRESS_POLICY_RUNTIME_VERSION; print(EGRESS_POLICY_RUNTIME_VERSION)')" = "signed-exact-query-v1" \
    && chmod -R a-w /opt/chatds-browser-runtime \
      /usr/local/lib/python3.12/site-packages/chatds_browser_runtime \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 \
      /usr/bin/apt /usr/bin/apt-get /usr/bin/apt-cache /usr/bin/apt-config \
    && rm -rf /usr/local/lib/python3.12/site-packages/pip \
      /usr/local/lib/python3.12/site-packages/pip-* \
      /usr/local/lib/python3.12/ensurepip \
    && ! command -v npm \
    && ! command -v npx \
    && ! command -v pip \
    && ! command -v pip3 \
    && ! command -v apt \
    && ! command -v apt-get

WORKDIR /workspace
USER 65529:65529

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD ["/usr/local/bin/chatds-browser-runtime-health"]

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/local/bin/chatds-browser-runtime-health"]

# Single fixed-size production sandbox target. The process protocol
# implementation serves one serialized worker identity across one-shot code,
# declared commands, exact Skill scripts, and persistent leases. No
# application-network attachment or shared CDP transport is present.
FROM browser-runtime AS session-sandbox

LABEL org.opencontainers.image.title="ChatDS unified session sandbox" \
      org.opencontainers.image.description="Single immutable Python/Node/Bash/Playwright/Selenium executor with signed origin egress policy" \
      org.opencontainers.image.chatds.executor-profile="session-sandbox-v1"

USER 0:0
COPY server.py /app/server.py
RUN chmod 0555 /usr/local/bin/chatds-browser-executor-entrypoint \
    && chmod 0444 /app/server.py \
    && chown root:root /workspace \
    && chmod 0755 /workspace

ENV EXECUTOR_RUNTIME_PROFILE=session-sandbox-v1 \
    EXECUTOR_ALLOWED_REQUEST_KINDS=runtime_capabilities,process_lease,skill_script,declared_command,session_code,legacy_code \
    EXECUTOR_MAX_PROCESS_LEASES=1 \
    EXECUTOR_MAX_PROCESS_LEASES_PER_SCOPE=1

USER 0:0

HEALTHCHECK --interval=5s --timeout=3s --retries=20 --start-period=10s \
  CMD ["/usr/local/bin/python", "-I", "/app/server.py", "--healthcheck"]

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/chatds-browser-executor-entrypoint"]
CMD []
