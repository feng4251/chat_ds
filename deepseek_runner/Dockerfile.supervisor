FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/shared

WORKDIR /app
COPY claude_runner/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -rf /root/.cache /tmp/requirements.txt

COPY deepseek_runner /app/deepseek_runner
COPY claude_runner/__init__.py claude_runner/policy.py /app/claude_runner/
COPY native_security /app/native_security
COPY backend/workspace_lock.py /app/shared/workspace_lock.py

RUN mkdir -p /var/lib/chatds-deepseek-harness-runner \
    && chmod -R a-w /app \
    && chmod 0700 /var/lib/chatds-deepseek-harness-runner

EXPOSE 8040
CMD ["python", "-m", "uvicorn", "deepseek_runner.server:app", "--host", "0.0.0.0", "--port", "8040", "--timeout-graceful-shutdown", "20"]
