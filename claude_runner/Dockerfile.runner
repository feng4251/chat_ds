ARG CLAUDE_CODE_VERSION=2.1.152
ARG NATIVE_SESSION_RUNTIME_IMAGE=chat_ds-native-session-runtime
FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS claude-package
ARG CLAUDE_CODE_VERSION
WORKDIR /build
RUN npm install --ignore-scripts --omit=dev --no-audit --no-fund \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    # The wrapper package intentionally ships a tiny placeholder at its bin
    # path and its postinstall replaces it with the platform package.  Keep
    # third-party lifecycle scripts disabled, but perform that one operation
    # explicitly after checking both pinned package versions.
    && platform_arch="$(node -p 'process.arch')" \
    && case "${platform_arch}" in x64|arm64) ;; *) exit 1 ;; esac \
    && native_package="@anthropic-ai/claude-code-linux-${platform_arch}" \
    && test "$(node -p "require('/build/node_modules/${native_package}/package.json').version")" = "${CLAUDE_CODE_VERSION}" \
    && native_binary="$(node -p "require('path').join(require('path').dirname(require.resolve('${native_package}/package.json')), 'claude')")" \
    && test -f "${native_binary}" \
    && test "$(stat -c %s "${native_binary}")" -gt 100000000 \
    && install -m 0555 "${native_binary}" /build/node_modules/@anthropic-ai/claude-code/bin/claude.exe \
    && npm cache clean --force \
    && test "$(node -p "require('/build/node_modules/@anthropic-ai/claude-code/package.json').version")" = "${CLAUDE_CODE_VERSION}" \
    && /build/node_modules/.bin/claude --version | grep -F "${CLAUDE_CODE_VERSION}"

# The schedule parser is a controller dependency, not a model-installable
# package. Build it immutably outside the final no-package-manager runtime.
FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS schedule-package
COPY claude_runner/schedule-requirements.txt /tmp/schedule-requirements.txt
RUN python -m pip install \
      --prefix=/install \
      --no-deps \
      --no-cache-dir \
      --require-hashes \
      -i https://pypi.tuna.tsinghua.edu.cn/simple \
      -r /tmp/schedule-requirements.txt

FROM ${NATIVE_SESSION_RUNTIME_IMAGE}
ARG CLAUDE_CODE_VERSION=2.1.152

LABEL org.opencontainers.image.title="ChatDS isolated Claude Code Turn runner" \
      org.opencontainers.image.version="${CLAUDE_CODE_VERSION}" \
      org.opencontainers.image.chatds.network="none+signed-exact-and-public-read-egress-v3" \
      org.opencontainers.image.chatds.egress-policy="signed-route-idle-v2" \
      org.opencontainers.image.chatds.runner-runtime="installed-isolated-package-v1" \
      org.opencontainers.image.chatds.workspace-scope="one-session" \
      org.opencontainers.image.chatds.setid-stripped="true"

COPY --from=claude-package /build/node_modules /opt/chatds-claude-code/node_modules
COPY --from=schedule-package /install/ /usr/local/
COPY claude_runner/bootstrap.py /opt/chatds-claude-runner/bootstrap.py
COPY claude_runner/__init__.py \
     claude_runner/runner_entrypoint.py \
     claude_runner/runtime_capabilities.py \
     claude_runner/native_control.py \
     claude_runner/artifact_stop_hook.py \
     claude_runner/native_workflow.py \
     claude_runner/native_lifecycle_hook.py \
     claude_runner/input_attachments.py \
     claude_runner/image_selftest.py \
     claude_runner/mcp_web_search.py \
     claude_runner/mcp_market_data.py \
     claude_runner/mcp_schedule_control.py \
     claude_runner/mcp_process.py \
     /opt/chatds-claude-runner/python/claude_runner/
COPY backend/schedule_spec.py /opt/chatds-claude-runner/python/claude_runner/schedule_spec.py
COPY native_security/__init__.py \
     native_security/run_control.py \
     /opt/chatds-claude-runner/python/native_security/

RUN ln -s /opt/chatds-claude-code/node_modules/.bin/claude /usr/local/bin/claude \
    && mkdir -p /run/chatds /state /skill-view /runtime /app/claude-runner \
    && purelib="$(python -I -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && test -d "${purelib}" \
    && ln -s /opt/chatds-claude-runner/python/claude_runner "${purelib}/claude_runner" \
    && ln -s /opt/chatds-claude-runner/python/native_security "${purelib}/native_security" \
    # Compatibility aliases permit an old, already-frozen Skill view to run
    # during a rolling Backend/Runner transition. Newly compiled views use
    # the installed ``python -I -m claude_runner.*`` entrypoints.
    && ln -s /opt/chatds-claude-runner/python/claude_runner/mcp_web_search.py /app/claude-runner/mcp_web_search.py \
    && ln -s /opt/chatds-claude-runner/python/claude_runner/mcp_market_data.py /app/claude-runner/mcp_market_data.py \
    && ln -s /opt/chatds-claude-runner/python/claude_runner/mcp_schedule_control.py /app/claude-runner/mcp_schedule_control.py \
    && ln -s /opt/chatds-claude-runner/python/claude_runner/mcp_process.py /app/claude-runner/mcp_process.py \
    && chmod 0555 /opt/chatds-claude-runner/bootstrap.py \
    && chmod -R a-w /opt/chatds-claude-code /opt/chatds-claude-runner \
    && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
    && getcap -r / 2>/dev/null | cut -d ' ' -f 1 | xargs -r setcap -r \
    && test -z "$(find / -xdev -type f -perm /6000 -print -quit)" \
    && test -z "$(getcap -r / 2>/dev/null)" \
    && test "$(python -I -c 'from chatds_browser_runtime.proxy_bridge import EGRESS_POLICY_RUNTIME_VERSION; print(EGRESS_POLICY_RUNTIME_VERSION)')" = "signed-route-idle-v2" \
    && test "$(python -I -c 'import importlib.metadata; print(importlib.metadata.version("croniter"))')" = "6.2.4" \
    && claude --version | grep -F "${CLAUDE_CODE_VERSION}" \
    # This is the same Python/bootstrap command used by the final ENTRYPOINT;
    # it also performs real stdio MCP handshakes under isolated mode.
    && /usr/local/bin/python -I /opt/chatds-claude-runner/bootstrap.py --chatds-image-self-test

USER 0:0
HEALTHCHECK NONE
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/python", "-I", "/opt/chatds-claude-runner/bootstrap.py"]
CMD []
