# Copy to .env and customize. docker compose picks up .env automatically.

# Canonical host storage roots shared by Backend and Harness. Production
# deployments must use absolute paths so a different Compose working/project
# directory cannot silently split the two services onto different Skill trees.
# Long-syntax bind mounts refuse to auto-create a misspelled source path.
# Compose intentionally has no fallback for either variable; an omitted value
# must fail before a clean-archive deployment can recreate a stateful service.
# The relative values below are suitable only when Compose always runs from the
# canonical development checkout; replace both with absolute paths in production.
CHATDS_DATA_ROOT=./data
CHATDS_MEMORY_ROOT=./harness/data/memories

# JWT signing key — REPLACE in production.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-me-with-a-real-secret

# Shared only by backend and harness internal control-plane calls.
# Generate independently from SECRET_KEY.
INTERNAL_API_TOKEN=replace-me-with-an-independent-random-token
# External OpenAI-compatible agent models.  Keep the key only in the
# permission-restricted production .env; never commit a live value.
SHAIENGINE_BASE_URL=https://api.shaiengine.com/v1
SHAIENGINE_API_KEY=replace-me-with-the-provider-key
# HMAC authority shared only by Harness and the process-lease executors.
# Use a different random value of at least 32 bytes.
EXECUTOR_V2_AUTH_TOKEN=replace-me-with-a-separate-32-byte-minimum-random-token
# Executor pool UDS membership is fixed together with its matching private
# named-volume mounts in docker-compose.yml; it is intentionally not an
# independently overridable deployment variable.
LLM_STREAM_TOTAL_TIMEOUT_SECONDS=14400
# Delegated children renew this soft lease with material progress. Provider
# admission waiting is exempt; an independent hard deadline still applies.
DELEGATION_BATCH_TIMEOUT_SECONDS=3600
DELEGATION_BATCH_HARD_TIMEOUT_SECONDS=21600
# Backend-to-Harness idle/read deadline; keep above the 4h Harness ceiling.
HARNESS_STREAM_TIMEOUT_SECONDS=18000
# The shared lock root is fixed by docker-compose.yml on a host-local named
# volume. Only the bounded acquisition timeout is deployment-configurable;
# never point workspace mutation locks at the NFS workspace filesystem.
WORKSPACE_MUTATION_LOCK_TIMEOUT_SECONDS=2
WORKSPACE_ORPHAN_LOCK_TIMEOUT_SECONDS=0.25
WORKSPACE_ORPHAN_RECONCILE_LIMIT=256
WORKSPACE_ORPHAN_RECONCILE_INTERVAL_SECONDS=60

# Web search provider chain. DDG is an explicit optional fallback.
# Local same-compose SearXNG: docker compose --profile local-search up -d searxng
# Remote harness using this host's SearXNG: set SEARXNG_BASE_URL=http://10.10.132.126:8088 on the remote host.
# Keep production traffic on the SearXNG aggregation boundary. `ddg` remains
# an optional Harness fallback, but requires direct public egress from Harness.
WEB_SEARCH_PROVIDERS=searxng
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_TIMEOUT_SECONDS=10
# Typed quote capability. The internal gateway, not the model, selects fixed
# public providers and accepts only market/symbol/exchange arguments.
MARKET_DATA_URL=http://market-data-gateway:8090/v1/quote
CLAUDE_MARKET_DATA_URL=http://market-data-gateway:8090/v1/quote
MARKET_DATA_PRIVATE_ORIGIN=http://market-data-gateway:8090
SEARXNG_SECRET=replace-me-with-a-random-searxng-secret
# Valkey is started by the local-search profile. It supports SearXNG's
# optional inbound limiter; general search-result caching belongs to Harness.
SEARXNG_VALKEY_URL=valkey://searxng-valkey:6379/0
SEARXNG_VALKEY_MAXMEMORY=128mb
# limiter.toml pass-lists the production Harness and protects other LAN callers.
SEARXNG_LIMITER=true
# Exact private HTTP(S) origins that browser tools may access only when the
# current user turn contains that URL, or explicitly continues the nearest
# bounded user-authored URL turn. Assistant/tool/ambient URLs never grant it.
# Empty = deny.
BROWSER_PRIVATE_ORIGIN_ALLOWLIST=
# Optional comma-separated base64 SHA-256 SPKI hashes for allowlisted internal
# HTTPS certificates. This is certificate-scoped; global TLS bypass is forbidden.
BROWSER_TLS_SPKI_ALLOWLIST=
# Preferred exact-origin private TLS pins, for example:
# {"https://internal.example:443":["BASE64_SHA256_SPKI="]}
# This validates a certificate only after the independent origin/CIDR gates;
# it does not add the origin to either the deployment or per-run whitelist.
SKILL_EGRESS_UPSTREAM_TLS_SPKI_PINS=
# Optional only when a controlled transparent proxy returns synthetic public
# DNS addresses. Literal IP URLs and ranges outside the fixed supported
# carriers remain blocked. Leave empty on ordinary DNS.
BROWSER_DNS_SYNTHETIC_PUBLIC_RANGES=
# Fail-fast connection budget for the private Chromium sidecar transport.
BROWSER_CDP_CONNECT_TIMEOUT_SECONDS=10
# The unified session sandbox uses network_mode:none. A per-execution,
# controller-owned loopback bridge relays only to the fail-closed proxy UDS.
# Public destinations must also come from the current Skill's frozen URL
# grants. Private destinations require the exact deployment/user-turn origin
# intersection above; hostname origins additionally require every DNS answer
# to remain inside one of these comma-separated CIDRs. Exact literal-IP
# origins are pinned to that address and do not require a redundant /32 or
# /128 entry. Empty remains deny-all.
SKILL_EGRESS_PRIVATE_CIDR_ALLOWLIST=
SKILL_EGRESS_PUBLIC_PORTS=80,443
SKILL_EGRESS_CONNECT_TIMEOUT_SECONDS=10
SKILL_EGRESS_IDLE_TIMEOUT_SECONDS=30
SKILL_EGRESS_MAX_TUNNEL_SECONDS=600
# Aggregate policy-v3 budgets shared by every sandbox/delegate invocation in
# one root run. They bound possible disclosure; they do not turn arbitrary
# HTTP paths, queries, or headers into a mathematically upload-free channel.
SKILL_EGRESS_MAX_REQUESTS=2048
SKILL_EGRESS_MAX_OUTBOUND_BYTES=16777216
SKILL_EGRESS_MAX_RESPONSE_WIRE_BYTES=536870912
# Bounded in-memory proxy ledger retention. Expiry does not widen a still-live
# request: a reused scope starts a new budget only after this deployment-owned
# retention horizon.
SKILL_EGRESS_MAX_POLICY_SCOPE_ENTRIES=65536
SKILL_EGRESS_POLICY_SCOPE_TTL_SECONDS=86400
# Four fixed executor slots x eight per-execution bridge connections.
SKILL_EGRESS_MAX_CONCURRENT_CONNECTIONS=32
# One-time cutover only: export this as 1 while the old public-only proxy
# trust volume is drained and migrated. Never persist it in production.
# SKILL_EGRESS_ALLOW_LEGACY_TRUST_MIGRATION=0
# Host port for local SearXNG. Keep 127.0.0.1 for local-only; set to LAN IP/0.0.0.0 only if remote harness must call this host.
SEARXNG_HOST_BIND=127.0.0.1
SEARXNG_HOST_PORT=8088
